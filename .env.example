# =============================================================================
# SSU - UMSS | Ejemplo de variables de entorno
# -----------------------------------------------------------------------------
#   cp .env.example .env
#
# Despues completa DATABASE_URL con las credenciales de la instancia unica de
# Supabase que administra el DB Admin del equipo.
#
# IMPORTANTE: la base de datos NO vive en Docker. Docker solo ejecuta el codigo;
# la conexion sale del contenedor hacia Supabase Cloud (PostgreSQL 16) por SSL.
# El archivo `.env` esta en .gitignore y jamas se sube al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor HTTP
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Base de datos: Supabase Cloud (PostgreSQL 16) - conexion directa, requiere SSL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.ozbbxhqlsczxmejabjap:gykcos-gukzuf-5qAcqi@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------
# Autenticacion JWT (firmado con HS256)
# Generar un secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cada integrante genera el suyo: el token solo vale dentro de su entorno.
# -----------------------------------------------------------------------------
JWT_SECRET=a5ba377f2f26c824e3b1a8746cfc5e4ebbb1e63d513de4daad6dd1d5fa9fe1a94722bb836210f65feb115937fd23bf19051e4a765f66b672395093d85f030b6d
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Alternativa a DATABASE_URL (variables individuales de libpq)
# -----------------------------------------------------------------------------
PGHOST=db.ozbbxhqlsczxmejabjap.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=gykcos-gukzuf-5qAcqi
PGDATABASE=postgres
PGSSL=true

# Tamano maximo del pool de conexiones
PG_POOL_MAX=20

# -----------------------------------------------------------------------------
# Frontend
# `false` desactiva la busqueda automatica de dist/ y obliga a compilar a mano.
# En Docker el build de la imagen ya compila, asi que normalmente no se toca.
# -----------------------------------------------------------------------------
FRONTEND_AUTOBUILD=false

# -----------------------------------------------------------------------------
# Solo pruebas automatizadas (tests/), no tocar en uso normal
# -----------------------------------------------------------------------------
# SSU_BASE_URL=http://localhost:3000
# SSU_SIS=202001001
# SSU_CI=8765432CB
